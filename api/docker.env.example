# 複製成 api/docker.env 後填值（已被 .gitignore 擋掉，不會進版控）。
# docker-compose 讀取巢狀設定用 __ 取代 appsettings.json 裡的 :

# PRORIL_WEB。測試區與正式區的資料庫同名，靠 port 區分（測試 ,50002 / 正式 ,51002）。
ConnectionStrings__ProrilWeb=Server=<host>,50002;Database=PRORIL_WEB;User Id=<user>;Password=<password>;TrustServerCertificate=True;

# 必須與 1.0 PRORIL 的 appsettings.json 完全相同，否則兩邊 token 不互通，所有請求都會 401。
JwtSettings__SignKey=<照抄 1.0 PRORIL/appsettings.json 的 JwtSettings:SignKey>

# 1.0 AesHelper 硬編在程式裡的那把金鑰。M_User.Password 是用它加密的，不同就永遠登不進去。
Security__AesKey=<照抄 1.0 PRORIL/Helper/AesHelper.cs 的 privateKey>

# 附件共享根目錄。容器內固定走這個路徑，實際檔案由 docker-compose.yml 的 volumes 掛進來，
# 掛的host路徑必須跟 1.0 指向同一個共享目錄，否則讀不到既有附件。
Storage__ShareRoot=/app/ProrilWebFiles

# 只有『瀏覽器直接打這支 API』才需要；走 Nuxt /api/proxy 是同源，可留空。
Cors__AllowedOrigins__0=

# MainApi/LoginSso 專用的內部共用密鑰，跟 Nuxt 環境變數 NUXT_SSO_INTERNAL_SECRET 設成同一組隨機字串。
Sso__InternalSecret=
