# ASP.NET 後端 API 網址（保留 1.0 原本 API 邏輯，前端僅重構）
# 注意：後端 Controller 無 /api 前綴，路徑為網站根目錄（例如 /CustomerApi/GetCustomerList）
# 前端一律呼叫本專案的 /api/proxy/** 再由 server/api/proxy/[...path].ts 轉發至此網址，
# 避免瀏覽器直接跨網域呼叫後端造成 CORS 阻擋
NUXT_PUBLIC_API_BASE=https://intranet-dev.proril.com

# 非正式環境（Staging/測試站）設為 true 以封鎖爬蟲索引
NUXT_PUBLIC_BLOCK_ROBOTS=false
