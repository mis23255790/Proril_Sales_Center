# ASP.NET 後端 API 網址（保留 1.0 原本 API 邏輯，前端僅重構）
# 注意：後端 Controller 無 /api 前綴，路徑為網站根目錄（例如 /CustomerApi/GetCustomerList）
# 前端一律呼叫本專案的 /api/proxy/** 再由 server/api/proxy/[...path].ts 轉發至此網址，
# 避免瀏覽器直接跨網域呼叫後端造成 CORS 阻擋
# 指向 1.0 的 .NET 站台（搬移期間的預設）
NUXT_PUBLIC_API_BASE=https://intranet-dev.proril.com
# 改指向本專案自己的 .NET API（api/），先設好 api/appsettings.Development.json 再啟動：
#   dotnet run --project api/Proril.SalesIssue.Api.csproj --urls http://localhost:5211
# NUXT_PUBLIC_API_BASE=http://localhost:5211

# 非正式環境（Staging/測試站）設為 true 以封鎖爬蟲索引
NUXT_PUBLIC_BLOCK_ROBOTS=false

# 開發用 JWT（沒有登入頁時暫時用它打後端 API；正式環境請留空）
NUXT_PUBLIC_DEV_TOKEN=

# 非正式環境設為 true，全站鋪滿半透明「開發環境」浮水印，避免跟正式站搞混；正式環境留空/false
NUXT_PUBLIC_SHOW_WATERMARK=false

# PRORIL 通行證 SSO（OAuth2 / OIDC，開發文件 https://oauth.proril.com/docs）
# 正式登入流程。Client ID 有值時，未登入者一律自動導去通行證；
# 留空時退回過渡做法（從 Manufacturing Center 帶 handoff 票證進來，見下方 NUXT_MFG_*）。
NUXT_PUBLIC_OAUTH_CLIENT_ID=
NUXT_PUBLIC_OAUTH_AUTHORIZE_URL=https://oauth.proril.com/oauth/authorize
# 必須跟去「我的 Channel」登記的 redirect_uri 一字不差
NUXT_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
NUXT_PUBLIC_OAUTH_SCOPE=openid

# 以下只在 Nuxt server 端使用（不會送到瀏覽器），故不加 PUBLIC 前綴
NUXT_OAUTH_TOKEN_URL=https://oauth.proril.com/oauth/token
NUXT_OAUTH_CLIENT_SECRET=
# 驗 id_token 簽章用，值取自 https://oauth.proril.com/.well-known/openid-configuration
NUXT_OAUTH_ISSUER=https://oauth.proril.com
NUXT_OAUTH_JWKS_URL=https://oauth.proril.com/.well-known/jwks.json
# 跟 api/appsettings 的 Sso:InternalSecret 設成同一組隨機字串，
# 用來擋 MainApi/LoginSso 被瀏覽器或外部直接呼叫（那支不驗密碼，只認這把密鑰）
NUXT_SSO_INTERNAL_SECRET=

# Manufacturing Center 身分交接（handoff，過渡用）：
# 相容 Manufacturing Center 目前「登入後帶 ticket 導頁過來 /auth/handoff?ticket=xxx」的做法，
# 這裡驗證票證簽章換自己的 token。等對方改成只放連結之後就可以拿掉。
# 跟 Manufacturing Center 那邊簽發票證用的密鑰必須設成同一組隨機字串，只在兩邊 server 端使用
NUXT_MFG_HANDOFF_SECRET=
# Manufacturing Center 首頁網址：沒設 Client ID 時登入頁的「從製造中心進入」、身分交接失敗時的返回按鈕
NUXT_PUBLIC_MFG_CENTER_URL=
