# 業務議題 schema 版控用的連線設定。
# 複製本檔為 database/.env 後填入實際值。.env 已被 .gitignore 排除，絕對不要進版控。
# CI 上請改用 GitLab / GitHub 的 masked variable，不要放檔案。
#
# 帳號權限建議：
#   extract / drift  只需要 VIEW DEFINITION + VIEW ANY DEFINITION（唯讀）
#   publish          才需要 ALTER 權限，且建議只給 CI 的部署帳號，開發者本機不要有

# 測試區
PRORIL_DB_TEST=Data Source=192.168.1.142,50002;Initial Catalog=PRORIL_WEB;User ID=<user>;Password=<password>;TrustServerCertificate=true;Connection Timeout=300;

# 正式區
PRORIL_DB_PROD=Data Source=192.168.1.142,51002;Initial Catalog=PRORIL_WEB;User ID=<user>;Password=<password>;TrustServerCertificate=true;Encrypt=False;Connection Timeout=300;
