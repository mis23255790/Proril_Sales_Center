# 業務議題 schema 版控用的連線設定。
# 複製本檔為 database/.env 後填入實際值。.env 已被 .gitignore 排除，絕對不要進版控。
# CI 上請改用 GitLab / GitHub 的 masked variable，不要放檔案。
#
# 帳號權限建議：
#   extract / drift  只需要 VIEW DEFINITION + VIEW ANY DEFINITION（唯讀）
#   publish          才需要 ALTER 權限，且建議只給 CI 的部署帳號，開發者本機不要有

# 測試區
PRORIL_DB_TEST=Data Source=<host>,50002;Initial Catalog=PRORIL_WEB;User ID=<user>;Password=<password>;TrustServerCertificate=true;Connection Timeout=300;

# 正式區
PRORIL_DB_PROD=Data Source=<host>,51002;Initial Catalog=PRORIL_WEB;User ID=<user>;Password=<password>;TrustServerCertificate=true;Encrypt=False;Connection Timeout=300;

# 獨立資料庫快照 Proril_Sales_Center（CLAUDE.md 說的那個「快照，還沒真的切連線」的庫）。
# 目前只有測試區這一份；正式上線後另一個 instance 再建一份時，另外加變數，不要覆蓋這個。
PRORIL_DB_SNAPSHOT=Data Source=<host>,50002;Initial Catalog=Proril_Sales_Center;User ID=<user>;Password=<password>;TrustServerCertificate=true;Connection Timeout=300;
